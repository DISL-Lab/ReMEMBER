{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "gaps": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "evidence": {
            "items": {
              "additionalProperties": false,
              "properties": {
                "source_id": {
                  "pattern": "^T[0-9]+-S[0-9]+$",
                  "type": "string"
                },
                "status": {
                  "const": "resolve"
                },
                "validation": {
                  "const": 1
                },
                "vote_count": {
                  "maximum": 3,
                  "minimum": 2,
                  "type": "integer"
                },
                "votes": {
                  "additionalProperties": false,
                  "properties": {
                    "GLM": {
                      "enum": [
                        0,
                        1
                      ],
                      "type": "integer"
                    },
                    "Qwen": {
                      "enum": [
                        0,
                        1
                      ],
                      "type": "integer"
                    },
                    "gemma": {
                      "enum": [
                        0,
                        1
                      ],
                      "type": "integer"
                    }
                  },
                  "required": [
                    "GLM",
                    "Qwen",
                    "gemma"
                  ],
                  "type": "object"
                }
              },
              "required": [
                "source_id",
                "status",
                "validation",
                "vote_count",
                "votes"
              ],
              "type": "object"
            },
            "type": "array"
          },
          "gap_idx": {
            "minimum": 0,
            "type": "integer"
          },
          "gap_type": {
            "enum": [
              "C",
              "A",
              "L"
            ]
          },
          "target_sentence_numbers": {
            "items": {
              "minimum": 0,
              "type": "integer"
            },
            "minItems": 1,
            "type": "array",
            "uniqueItems": true
          }
        },
        "required": [
          "evidence",
          "gap_idx",
          "gap_type",
          "target_sentence_numbers"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "range": {
      "enum": [
        "8k~16k",
        "16k~32k",
        "32k~64k",
        "64k~128k",
        "128k~160k",
        "other"
      ]
    },
    "schema_version": {
      "const": "1.0"
    },
    "source": {
      "enum": [
        "evermembench",
        "locomo",
        "realtalk"
      ]
    },
    "window_id": {
      "pattern": "^[ELR]_U[0-9]{4}$",
      "type": "string"
    }
  },
  "required": [
    "gaps",
    "range",
    "schema_version",
    "source",
    "window_id"
  ],
  "title": "ReMEMber text-free annotations",
  "type": "object"
}
